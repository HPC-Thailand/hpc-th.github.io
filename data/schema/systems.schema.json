{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hpc.in.th/data/schema/systems.schema.json",
  "title": "HPC systems in Thailand",
  "type": "object",
  "required": ["updated", "systems"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "note": { "$ref": "i18n-string.json" },
    "systems": { "type": "array", "items": { "$ref": "#/definitions/system" } }
  },
  "definitions": {
    "organization": {
      "type": "object",
      "required": ["name_th", "name_en", "org_type", "province", "coordinates", "website", "contact_email"],
      "additionalProperties": false,
      "properties": {
        "name_th": { "type": "string" },
        "name_en": { "type": "string" },
        "org_type": { "enum": ["government_research", "university", "private", "state_enterprise"] },
        "province": { "type": "string" },
        "coordinates": {
          "type": "object",
          "required": ["lat", "lng"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": 5, "maximum": 21 },
            "lng": { "type": "number", "minimum": 96, "maximum": 106 }
          }
        },
        "website": { "type": "string", "format": "uri" },
        "contact_email": { "type": ["string", "null"], "format": "email" }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "system_id",
        "name",
        "organization",
        "status",
        "commissioned_date",
        "decommissioned_date",
        "vendor",
        "compute",
        "cooling",
        "network",
        "storage",
        "performance",
        "software_stack",
        "access"
      ],
      "additionalProperties": false,
      "properties": {
        "system_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique id, e.g. 'thaisc-lanta'"
        },
        "name": { "type": "string" },
        "organization": { "$ref": "#/definitions/organization" },
        "status": { "enum": ["operational", "planned", "maintenance", "decommissioned"] },
        "commissioned_date": { "type": ["string", "null"], "format": "date" },
        "decommissioned_date": { "type": ["string", "null"], "format": "date" },
        "vendor": { "type": "string" },
        "compute": {
          "type": "object",
          "required": ["num_cpu_type", "cpu_types", "num_gpu_type", "gpu_types", "total"],
          "additionalProperties": false,
          "properties": {
            "num_cpu_type": {
              "type": "integer",
              "minimum": 1,
              "description": "จำนวนชนิด CPU ที่แตกต่างกันในระบบนี้"
            },
            "cpu_types": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/cpu_type" }
            },
            "num_gpu_type": {
              "type": "integer",
              "minimum": 0,
              "description": "จำนวนชนิด GPU ที่แตกต่างกันในระบบนี้ (0 ถ้าเป็น CPU-only)"
            },
            "gpu_types": {
              "type": "array",
              "items": { "$ref": "#/definitions/gpu_type" }
            },
            "total": {
              "type": "object",
              "required": ["total_nodes", "total_cpu_cores", "total_gpu_count", "total_memory_tb"],
              "additionalProperties": false,
              "properties": {
                "total_nodes": { "type": "integer", "minimum": 0 },
                "total_cpu_cores": { "type": "integer", "minimum": 0 },
                "total_gpu_count": { "type": "integer", "minimum": 0 },
                "total_memory_tb": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "cooling": {
          "type": ["string", "null"],
          "description": "e.g. 'air-cooled', 'direct liquid cooling', 'immersion cooling'"
        },
        "network": {
          "type": "object",
          "required": ["interconnect_type", "bandwidth_gbps"],
          "additionalProperties": false,
          "properties": {
            "interconnect_type": {
              "type": "string",
              "description": "e.g. InfiniBand HDR200, Slingshot"
            },
            "bandwidth_gbps": { "type": "number", "minimum": 0 }
          }
        },
        "storage": {
          "type": "object",
          "required": ["type", "filesystem", "capacity_pb"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["parallel_fs", "object", "hybrid"] },
            "filesystem": { "type": "string", "description": "e.g. Lustre, WekaFS" },
            "capacity_pb": { "type": "number", "minimum": 0, "description": "Usable total, all tiers" },
            "nvme_pb": { "type": ["number", "null"], "minimum": 0, "description": "NVMe/flash tier" },
            "disk_pb": { "type": ["number", "null"], "minimum": 0, "description": "HDD/cold tier" }
          }
        },
        "performance": {
          "type": "object",
          "required": ["peak_pflops", "sustained_pflops", "power_consumption_kw"],
          "additionalProperties": false,
          "properties": {
            "peak_pflops": { "type": ["number", "null"], "minimum": 0, "description": "Rpeak" },
            "sustained_pflops": { "type": ["number", "null"], "minimum": 0, "description": "Rmax (HPL)" },
            "power_consumption_kw": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "software_stack": {
          "type": "object",
          "required": ["os", "scheduler", "frameworks"],
          "additionalProperties": false,
          "properties": {
            "os": { "type": "string" },
            "scheduler": { "enum": ["slurm", "pbs", "lsf", "other"] },
            "frameworks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "access": {
          "type": "object",
          "required": ["model", "user_base"],
          "additionalProperties": false,
          "properties": {
            "model": { "enum": ["open_academic", "restricted", "commercial", "hybrid"] },
            "user_base": {
              "type": "array",
              "items": { "enum": ["academic", "government", "industry", "sea_region"] }
            }
          }
        },
        "verifiedOn": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Date the system owner last verified this record; null shows an 'awaiting verification' badge"
        }
      }
    },
    "cpu_type": {
      "type": "object",
      "required": ["model", "nodes", "sockets_per_node", "cores_per_node", "memory_per_node_gb"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "nodes": { "type": "integer", "minimum": 0 },
        "sockets_per_node": { "type": ["integer", "null"], "minimum": 1 },
        "cores_per_node": { "type": "integer", "minimum": 0 },
        "memory_per_node_gb": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "gpu_type": {
      "type": "object",
      "required": ["model", "nodes", "gpu_per_node", "memory_per_unit_gb"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "nodes": { "type": "integer", "minimum": 0 },
        "gpu_per_node": { "type": "integer", "minimum": 1 },
        "memory_per_unit_gb": { "type": "number", "minimum": 0 }
      }
    }
  }
}
